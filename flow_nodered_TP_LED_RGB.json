  {
    "id": "tpl",
    "type": "template",
    "z": "tab_led",
    "name": "Page HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "plain",
    "template": "<!DOCTYPE html>\n<html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Node-RED - LED RGB</title>\n<style>\nbody{font-family:Arial,sans-serif;background:#1b1b1b;color:#fff;text-align:center;padding:20px}\nh1{color:#ff8a65}\n.led{width:110px;height:110px;border-radius:50%;margin:20px auto;border:4px solid #fff;background:#000}\nbutton{font-size:18px;padding:14px 18px;margin:6px;border:none;border-radius:10px;color:#fff;cursor:pointer;min-width:110px}\n.r{background:#c0392b}.g{background:#1e8449}.b{background:#1f4e9e}.o{background:#555}.w{background:#999;color:#000}\npre{background:#000;color:#7CFC9A;text-align:left;padding:10px;border-radius:8px;max-width:520px;margin:20px auto;white-space:pre-wrap}\n</style></head><body>\n<h1>Pilotage via Node-RED</h1>\n<p>Navigateur &rarr; Node-RED (port 1880) &rarr; Tab5 (port 80)</p>\n<div class=\"led\" id=\"led\"></div>\n<button class=\"r\" onclick=\"cmd('/api/led?color=red&state=toggle')\">Rouge</button>\n<button class=\"g\" onclick=\"cmd('/api/led?color=green&state=toggle')\">Vert</button>\n<button class=\"b\" onclick=\"cmd('/api/led?color=blue&state=toggle')\">Bleu</button><br>\n<button class=\"w\" onclick=\"cmd('/api/rgb?r=1&g=1&b=1')\">Blanc</button>\n<button class=\"o\" onclick=\"cmd('/api/off')\">Éteindre</button>\n<pre id=\"log\">...</pre>\n<script>\nasync function cmd(path){\n  const rep = await fetch('/led-rgb/cmd?path=' + encodeURIComponent(path));\n  const txt = await rep.text();\n  document.getElementById('log').textContent = 'Node-RED a relayé : GET ' + path + '\\nCode : ' + rep.status + '\\nRéponse : ' + txt;\n  try{ show(JSON.parse(txt)); }catch(e){}\n}\nfunction show(s){\n  document.getElementById('led').style.background =\n   'rgb(' + (s.red?255:0) + ',' + (s.green?255:0) + ',' + (s.blue?255:0) + ')';\n}\nsetInterval(()=>cmd('/api/state'), 2000); cmd('/api/state');\n</script></body></html>",
    "output": "str",
