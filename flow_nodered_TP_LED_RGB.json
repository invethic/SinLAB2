    "id": "httpreq",
    "type": "http request",
    "z": "tab_led",
    "name": "Requête HTTP vers Tab5",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
