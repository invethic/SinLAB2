  {
    "id": "parse",
    "type": "function",
    "z": "tab_led",
    "name": "Analyser la réponse",
    "func": "// msg.statusCode : code HTTP (200 = OK, 400 = mauvaise requête, 404 = introuvable)\n// msg.payload    : réponse JSON du Tab5, ex : {\"red\":1,\"green\":0,\"blue\":0}\nconst code = msg.statusCode;\nif (code === 200) {\n    const s = msg.payload;\n    const txt = 'R=' + s.red + ' V=' + s.green + ' B=' + s.blue;\n    node.status({fill:'green', shape:'dot', text: code + ' OK  ' + txt});\n} else {\n    node.status({fill:'red', shape:'ring', text: 'Erreur ' + code});\n}\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 840,
    "y": 360,
    "wires": [
