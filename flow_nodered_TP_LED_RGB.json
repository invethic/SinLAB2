  {
    "id": "build",
    "type": "function",
    "z": "tab_led",
    "name": "Construire l'URL",
    "func": "// msg.payload contient le chemin de la requête, ex : /api/led?color=red&state=on\nconst ip = flow.get('tab5_ip') || '192.168.1.50';\nmsg.url = 'http://' + ip + msg.payload;   // URL complète\nmsg.method = 'GET';                        // méthode HTTP\nnode.status({fill:'blue', shape:'dot', text:'GET ' + msg.payload});\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 360,
    "wires": [
