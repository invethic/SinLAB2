  {
    "id": "pstat",
    "type": "function",
    "z": "tab_led",
    "name": "Afficher l'état",
    "func": "if (msg.statusCode !== 200) {\n    node.status({fill:'red', shape:'ring', text:'Tab5 injoignable'});\n    return null;\n}\nconst s = msg.payload;\nconst noms = [];\nif (s.red) noms.push('ROUGE');\nif (s.green) noms.push('VERT');\nif (s.blue) noms.push('BLEU');\nconst txt = noms.length ? noms.join(' + ') : 'éteinte';\nnode.status({fill: noms.length ? 'green' : 'grey', shape:'dot', text:'LED : ' + txt + ' | ' + s.requests + ' requêtes'});\nflow.set('etat_led', s);   // mémorisé pour la page web Node-RED\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 740,
    "y": 660,
    "wires": [
      []
    ]
  },
