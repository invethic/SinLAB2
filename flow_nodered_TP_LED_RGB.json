  {
    "id": "relay",
    "type": "function",
    "z": "tab_led",
    "name": "Relayer vers le Tab5",
    "func": "// La page envoie ?path=/api/led?color=red&state=toggle\nconst path = msg.req.query.path || '/api/state';\nif (!path.startsWith('/api/')) {          // sécurité : on ne relaie que l'API\n    msg.statusCode = 400;\n    msg.payload = {error: 'chemin interdit'};\n    return [null, msg];\n}\nmsg.url = 'http://' + (flow.get('tab5_ip') || '192.168.1.50') + path;\nmsg.method = 'GET';\ndelete msg.payload;\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
